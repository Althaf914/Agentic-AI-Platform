# ── Database ──
DATABASE_URL=postgresql://agentforge:agentforge_secret@localhost:5432/agentforge_db
REDIS_URL=redis://localhost:6379/0
CHROMADB_HOST=localhost
CHROMADB_PORT=8001

# ── Auth ──
JWT_SECRET=change-this-in-production-use-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=1440

# ── AI: Groq (FREE — get key at console.groq.com) ──
GROQ_API_KEY=your-groq-api-key-here

# ── AI: Anthropic (optional — for Claude-powered agents) ──
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Search: SerpApi (100 FREE searches/month — serpapi.com) ──
SERPAPI_KEY=your-serpapi-key-here

# ── Email: Hunter.io (100 FREE searches/month — hunter.io) ──
HUNTER_API_KEY=your-hunter-io-key-here

# ── Technology profiling: BuiltWith (optional) ──
BUILTWITH_API_KEY=your-key-here-optional

# ── Frontend ──
FRONTEND_URL=http://localhost:5173

# ── Dev flags ──
USE_MOCK_DATA=false
MOCK_COMPANY_COUNT=20
